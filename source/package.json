{
  "name": "reejfastorg-setup",
  "displayName": "ReejFastOrg Setup",
  "description": "Connect to a Salesforce org (dev, sandbox, prod) with the sf CLI, pick packages from a catalog and install them in order, with post-install steps.",
  "version": "0.6.0",
  "publisher": "reej",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "salesforce",
    "sf cli",
    "package",
    "org setup"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reejFastOrg.runSetup",
        "title": "Run Org Setup (choose packages for the connected org)",
        "shortTitle": "Run Setup",
        "category": "ReejFastOrg",
        "icon": "$(rocket)"
      },
      {
        "command": "reejFastOrg.openPackages",
        "title": "Open Package Screen",
        "category": "ReejFastOrg",
        "icon": "$(extensions)"
      },
      {
        "command": "reejFastOrg.connectOrg",
        "title": "Connect to an Org",
        "category": "ReejFastOrg",
        "icon": "$(plug)"
      },
      {
        "command": "reejFastOrg.installPackages",
        "title": "Install Packages (choose from a list)…",
        "category": "ReejFastOrg",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reejFastOrg.openCatalog",
        "title": "Open / Create Package Catalog",
        "category": "ReejFastOrg",
        "icon": "$(json)"
      },
      {
        "command": "reejFastOrg.refresh",
        "title": "Refresh",
        "category": "ReejFastOrg",
        "icon": "$(refresh)"
      },
      {
        "command": "reejFastOrg.showLog",
        "title": "Show Log",
        "category": "ReejFastOrg",
        "icon": "$(output)"
      },
      {
        "command": "reejFastOrg.installPackage",
        "title": "Install This Package",
        "category": "ReejFastOrg",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reejFastOrg.copyVersionId",
        "title": "Copy Package Version Id",
        "category": "ReejFastOrg",
        "icon": "$(copy)"
      },
      {
        "command": "reejFastOrg.useOrg",
        "title": "Use This Org",
        "category": "ReejFastOrg",
        "icon": "$(arrow-right)"
      },
      {
        "command": "reejFastOrg.openOrg",
        "title": "Open Org in Browser",
        "category": "ReejFastOrg",
        "icon": "$(link-external)"
      },
      {
        "command": "reejFastOrg.openInstalledPackages",
        "title": "Open Installed Packages Page",
        "category": "ReejFastOrg",
        "icon": "$(package)"
      },
      {
        "command": "reejFastOrg.disconnectOrg",
        "title": "Disconnect (forget the connected org)",
        "category": "ReejFastOrg",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "reejFastOrg.installChecked",
        "title": "Install Selected Packages",
        "category": "ReejFastOrg",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reejFastOrg.selectAll",
        "title": "Select All Packages",
        "category": "ReejFastOrg",
        "icon": "$(check-all)"
      },
      {
        "command": "reejFastOrg.selectNone",
        "title": "Clear Package Selection",
        "category": "ReejFastOrg",
        "icon": "$(clear-all)"
      },
      {
        "command": "reejFastOrg.addPackage",
        "title": "Add Package to Catalog…",
        "category": "ReejFastOrg",
        "icon": "$(add)"
      },
      {
        "command": "reejFastOrg.removePackage",
        "title": "Remove from Catalog",
        "category": "ReejFastOrg",
        "icon": "$(trash)"
      },
      {
        "command": "reejFastOrg.chooseCatalog",
        "title": "Choose Package Catalog…",
        "category": "ReejFastOrg",
        "icon": "$(folder-opened)"
      }
    ],
    "configuration": {
      "title": "ReejFastOrg Setup",
      "properties": {
        "reejFastOrg.catalogPath": {
          "type": "string",
          "default": ".reejfastorg/packages.json",
          "description": "Package catalog JSON. Absolute path (recommended in User settings, so every workspace uses the same catalog) or a path relative to the first workspace folder."
        },
        "reejFastOrg.waitMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Minutes the sf CLI waits for each package install before the extension switches to polling the install request."
        },
        "reejFastOrg.securityType": {
          "type": "string",
          "enum": [
            "AdminsOnly",
            "AllUsers"
          ],
          "default": "AdminsOnly",
          "description": "Who gets access to installed packages (sf package install --security-type). Also switchable in the package screen before each install; the choice is remembered here."
        },
        "reejFastOrg.skipAlreadyInstalled": {
          "type": "boolean",
          "default": true,
          "description": "Skip a package (and its post-install steps) when the exact same version is already installed in the org."
        },
        "reejFastOrg.stopOnError": {
          "type": "boolean",
          "default": true,
          "description": "Stop the sequence at the first failed package install or post-install step."
        },
        "reejFastOrg.sfPath": {
          "type": "string",
          "default": "",
          "description": "Full path of the Salesforce CLI executable, when \"sf\" is not found on VS Code's PATH (e.g. C:\\\\Program Files\\\\sf\\\\bin\\\\sf.cmd). Leave empty to auto-detect."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reejFastOrg",
          "title": "ReejFastOrg",
          "icon": "media/reej-fastorg-activity.svg"
        }
      ]
    },
    "views": {
      "reejFastOrg": [
        {
          "id": "reejFastOrg.home",
          "name": "ReejFastOrg",
          "icon": "media/reej-fastorg-activity.svg",
          "contextualTitle": "ReejFastOrg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "reejFastOrg.openPackages",
          "when": "view == reejFastOrg.home",
          "group": "navigation@0"
        },
        {
          "command": "reejFastOrg.installChecked",
          "when": "view == reejFastOrg.home",
          "group": "navigation@1"
        },
        {
          "command": "reejFastOrg.connectOrg",
          "when": "view == reejFastOrg.home",
          "group": "navigation@2"
        },
        {
          "command": "reejFastOrg.addPackage",
          "when": "view == reejFastOrg.home",
          "group": "navigation@3"
        },
        {
          "command": "reejFastOrg.refresh",
          "when": "view == reejFastOrg.home",
          "group": "navigation@4"
        },
        {
          "command": "reejFastOrg.runSetup",
          "when": "view == reejFastOrg.home",
          "group": "1_actions@1"
        },
        {
          "command": "reejFastOrg.installPackages",
          "when": "view == reejFastOrg.home",
          "group": "1_actions@2"
        },
        {
          "command": "reejFastOrg.openCatalog",
          "when": "view == reejFastOrg.home",
          "group": "2_catalog@1"
        },
        {
          "command": "reejFastOrg.chooseCatalog",
          "when": "view == reejFastOrg.home",
          "group": "2_catalog@2"
        },
        {
          "command": "reejFastOrg.showLog",
          "when": "view == reejFastOrg.home",
          "group": "3_misc@1"
        },
        {
          "command": "reejFastOrg.disconnectOrg",
          "when": "view == reejFastOrg.home",
          "group": "3_misc@2"
        }
      ],
      "view/item/context": [
        {
          "command": "reejFastOrg.openPackages",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "inline@0"
        },
        {
          "command": "reejFastOrg.openOrg",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.connectOrg",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "inline@2"
        },
        {
          "command": "reejFastOrg.openOrg",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "1_open@1"
        },
        {
          "command": "reejFastOrg.openInstalledPackages",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "1_open@2"
        },
        {
          "command": "reejFastOrg.connectOrg",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "2_org@1"
        },
        {
          "command": "reejFastOrg.disconnectOrg",
          "when": "view == reejFastOrg.home && viewItem == fastCurrentOrg",
          "group": "2_org@2"
        },
        {
          "command": "reejFastOrg.installPackage",
          "when": "view == reejFastOrg.home && viewItem == fastPackage",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.installPackage",
          "when": "view == reejFastOrg.home && viewItem == fastPackage",
          "group": "1_install@1"
        },
        {
          "command": "reejFastOrg.copyVersionId",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastPackage/",
          "group": "2_copy@1"
        },
        {
          "command": "reejFastOrg.useOrg",
          "when": "view == reejFastOrg.home && viewItem == fastAuthOrg",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.openOrg",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastAuthOrg/",
          "group": "inline@2"
        },
        {
          "command": "reejFastOrg.useOrg",
          "when": "view == reejFastOrg.home && viewItem == fastAuthOrg",
          "group": "1_org@1"
        },
        {
          "command": "reejFastOrg.openOrg",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastAuthOrg/",
          "group": "1_org@2"
        },
        {
          "command": "reejFastOrg.openInstalledPackages",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastAuthOrg/",
          "group": "1_org@3"
        },
        {
          "command": "reejFastOrg.refresh",
          "when": "view == reejFastOrg.home && viewItem == fastSection.orgs",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.showLog",
          "when": "view == reejFastOrg.home && viewItem == fastSection.lastRun",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.installChecked",
          "when": "view == reejFastOrg.home && viewItem == fastSection.packages.selected",
          "group": "inline@1"
        },
        {
          "command": "reejFastOrg.addPackage",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "inline@2"
        },
        {
          "command": "reejFastOrg.installChecked",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "1_install@1"
        },
        {
          "command": "reejFastOrg.selectAll",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "2_select@1"
        },
        {
          "command": "reejFastOrg.selectNone",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "2_select@2"
        },
        {
          "command": "reejFastOrg.addPackage",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "3_catalog@1"
        },
        {
          "command": "reejFastOrg.openCatalog",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "3_catalog@2"
        },
        {
          "command": "reejFastOrg.chooseCatalog",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastSection\\.packages/",
          "group": "3_catalog@3"
        },
        {
          "command": "reejFastOrg.removePackage",
          "when": "view == reejFastOrg.home && viewItem =~ /^fastPackage/",
          "group": "9_remove@1"
        }
      ],
      "explorer/context": [
        {
          "command": "reejFastOrg.installPackages",
          "when": "resourcePath =~ /[\\\\/]\\.reejfastorg[\\\\/][^\\\\/]+\\.json$/",
          "group": "reejFastOrg@1"
        }
      ],
      "editor/title": [
        {
          "command": "reejFastOrg.installPackages",
          "when": "resourcePath =~ /[\\\\/]\\.reejfastorg[\\\\/][^\\\\/]+\\.json$/",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reejFastOrg.installPackage",
          "when": "false"
        },
        {
          "command": "reejFastOrg.copyVersionId",
          "when": "false"
        },
        {
          "command": "reejFastOrg.useOrg",
          "when": "false"
        },
        {
          "command": "reejFastOrg.openInstalledPackages",
          "when": "false"
        },
        {
          "command": "reejFastOrg.removePackage",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  }
}
